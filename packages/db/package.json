{
  "name": "@constant/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Postgres schema, migrations, ledger and order repositories.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@constant/rules": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "vitest": "^3.2.4"
  }
}
