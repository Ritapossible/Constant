# Copy to .env for local development. Never commit real values.
# Everything here is server-only (apps/api and apps/worker). Never prefix with NEXT_PUBLIC_.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/constant
# Tests create and drop their own databases on this server.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Payee encryption (smartcards, meters). 32 bytes each, base64: openssl rand -base64 32
REF_ENCRYPTION_KEY=
REF_HMAC_KEY=

# Local development with fake partners (refused when NODE_ENV=production):
#   api:    PARTNERS=fake
#   worker: VENDING_PROVIDER=fake MESSAGING_PROVIDER=fake
PARTNERS=
VENDING_PROVIDER=vtpass
MESSAGING_PROVIDER=

# Privy (sign-in). App secret and verification key from dashboard.privy.io → App settings.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# VTpass (cable renewals). Sandbox: https://sandbox.vtpass.com/api  Live: https://vtpass.com/api
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
# Random 16+ characters. Callback URL in VTpass: https://<api-host>/webhooks/vtpass/<this token>
VTPASS_WEBHOOK_TOKEN=
# Sent to VTpass when a user has no phone number on file.
VEND_FALLBACK_PHONE=

# Paystack dedicated accounts (funding). Test keys use PAYSTACK_PREFERRED_BANK=test-bank.
PAYSTACK_SECRET_KEY=
PAYSTACK_PREFERRED_BANK=wema-bank
FUNDING_EMAIL_DOMAIN=users.constant.ng

# Messages: email via Resend, SMS via Termii. Either or both.
RESEND_API_KEY=
EMAIL_FROM=Constant <hello@example.com>
TERMII_API_KEY=
TERMII_SENDER_ID=Constant

# The web app's origin(s), comma-separated, allowed to call the API from a browser.
WEB_ORIGINS=https://constant-units.vercel.app,http://localhost:3000

# Chains (worker). CHAINS turns on deposit indexing; empty = off.
CHAINS=base,arc
# Use a paid endpoint (Alchemy, QuickNode) in production; public ones rate-limit log queries.
BASE_RPC_URL=https://base-rpc.publicnode.com
ARC_RPC_URL=https://rpc.mainnet.arc.io
# true only with an RPC that allows log queries without a contract filter: also flags unsupported tokens.
DEPOSITS_ALL_TOKENS=false
# Receipt anchoring on Stellar. The secret of an account Constant owns; "fake" for local dev; empty = off.
STELLAR_NETWORK=testnet
STELLAR_SECRET=
