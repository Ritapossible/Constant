# Copy to .env for local development. Never commit real values.
# All keys are server-only. Never prefix with VITE_ or NEXT_PUBLIC_.

DATABASE_URL=postgres://constant:constant@localhost:5432/constant

# 32-byte keys, base64. Generate: openssl rand -base64 32
METER_ENCRYPTION_KEY=
METER_HMAC_KEY=
TOKEN_ENCRYPTION_KEY=

# WhatsApp Cloud API
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Partners. "fake" in development and tests.
VENDING_PROVIDER=fake
FUNDING_PROVIDER=fake
SMS_PROVIDER=fake
VENDING_WEBHOOK_SECRET=
FUNDING_WEBHOOK_SECRET=

RECEIPT_BASE_URL=http://localhost:3000/r
