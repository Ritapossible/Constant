# Sign-in and embedded wallets (https://dashboard.privy.io): create an app, enable
# Google, Email, SMS, Passkey and Wallet login, and add your site URL to Allowed origins.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional RPC overrides. Defaults are the public Base and Arc mainnet endpoints.
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_ARC_RPC_URL=

# Used for canonical links and social previews once you have a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional public contact shown on the privacy page.
NEXT_PUBLIC_CONTACT_EMAIL=

# The Constant API (apps/api), e.g. https://constant-api.onrender.com. When set, cable bills and the
# naira account are stored and paid on the server. Leave empty to keep the on-device preview.
NEXT_PUBLIC_API_URL=

# Dollar autopay (D-063/D-064): Constant's spender address on Base, the same value as SPENDER_ADDRESS on the API.
# Pinned into the app at build time; "Pay from USDC" is hidden until it's set.
NEXT_PUBLIC_SPENDER_ADDRESS=
