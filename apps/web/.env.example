# Where early-access sign-ups go. Set at least one.
# Any JSON webhook (Slack, Discord, Zapier, Make, Google Apps Script…)
WAITLIST_WEBHOOK_URL=
# Or straight to your Telegram: create a bot with @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used for social preview links.
# Leave empty on Vercel until you have a custom domain; then set it, e.g. https://yourdomain.com
NEXT_PUBLIC_SITE_URL=

# Optional public contact shown on the privacy page.
NEXT_PUBLIC_CONTACT_EMAIL=
